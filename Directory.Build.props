<Project>
  <PropertyGroup>
    <!--
      The 3.x line. A clean break from the 2.x Avalonia installer: different UI stack,
      different packaging (NSIS installer rather than a portable zip), no upgrade path
      from 2.x - users download 3.0.0 by hand once, and auto-update takes over after that.
    -->
    <Version>3.0.5</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <!-- Without this the SDK appends "+<commit-sha>", which the UI then shows to users. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Into The Latent</Authors>
    <Company>Into The Latent</Company>
    <Copyright>Copyright © Into The Latent</Copyright>
    <PackageProjectUrl>https://github.com/Into-The-Latent/DiffusionNexus.Installer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Into-The-Latent/DiffusionNexus.Installer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Solution-wide default for the local-SDK redirect in (untracked) Directory.Build.targets.
      That file auto-detects UseLocalSDK=true whenever the sibling SDK repo
      (..\DiffusionNexus.Installer.SDK) exists on disk - the standard developer layout - which
      would otherwise redirect every project's SDK PackageReferences to local ProjectReferences
      at whatever version is currently on disk there, conflicting with the pinned NuGet package
      versions elsewhere in the graph (NU1605 downgrade errors). Setting the default here, in
      this TRACKED file, means a plain build/test uses the published NuGet packages
      solution-wide, while both documented opt-ins keep working: the `UseLocalSDK` environment
      variable (this only seeds the property, so the Condition below leaves it alone) and
      `-p:UseLocalSDK=true` on the command line (a locked global property that no in-project
      assignment can overwrite). New projects added by later tasks inherit this policy for free
      instead of needing their own copy of this PropertyGroup.
    -->
    <UseLocalSDK Condition="'$(UseLocalSDK)' == ''">false</UseLocalSDK>
  </PropertyGroup>
</Project>
