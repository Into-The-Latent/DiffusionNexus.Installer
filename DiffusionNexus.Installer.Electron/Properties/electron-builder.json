{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/refs/heads/master/packages/app-builder-lib/scheme.json",
  "compression": "maximum",
  "win": {
    "icon": "bin/Assets/Branding/app.ico",
    "target": [
      {
        "target": "nsis",
        "arch": "x64"
      }
    ],
    "artifactName": "EasyWorkloadInstaller-ITL-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Easy Workload Installer - ITL",
    "installerIcon": "bin/Assets/Branding/app.ico",
    "uninstallerIcon": "bin/Assets/Branding/app.ico",
    "installerHeaderIcon": "bin/Assets/Branding/app.ico",
    "installerHeader": "bin/Assets/Branding/header.bmp",
    "installerSidebar": "bin/Assets/Branding/sidebar.bmp",
    "uninstallerSidebar": "bin/Assets/Branding/sidebar.bmp"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "Into-The-Latent",
      "repo": "DiffusionNexus.Installer",
      "releaseType": "release"
    }
  ]
}
