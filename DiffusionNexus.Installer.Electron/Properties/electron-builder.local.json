{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/refs/heads/master/packages/app-builder-lib/scheme.json",
  "compression": "maximum",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": "x64"
      }
    ],
    "artifactName": "DiffusionNexus-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "DiffusionNexus Installer"
  }
}
