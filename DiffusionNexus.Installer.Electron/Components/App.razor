<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @* The scoped-CSS bundle is named after PackageId, which ElectronNET.Core sets to
       ElectronPackageId - NOT after the assembly. Referencing the assembly name 404s, which
       silently breaks every .razor.css file; the visible symptom is Blazor's
       "An unhandled error has occurred" bar showing permanently, because the display:none
       that hides it lives in MainLayout.razor.css. Keep in sync with ElectronPackageId. *@
    <link rel="stylesheet" href="@Assets["diffusion-nexus-installer.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
