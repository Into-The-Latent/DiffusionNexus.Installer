@using DiffusionNexus.Installer.Core.Host
@using DiffusionNexus.Installer.Core.Modules
@using DiffusionNexus.Installer.Electron.Components.Shared
@inject IFolderPicker FolderPicker

@* Two panels, not one (issue #27): the output folder and the model folder are unrelated
   settings, and in one box the model switch read as if it governed the output path above it. *@
<section class="panel" data-role="output-panel">
    <h2>Output folder</h2>

    @* The "use my own output folder" switch (issue #27), the model folder's rule: on when an output
       folder is remembered, off when none is. Off means ComfyUI's own output folder. On needs a
       folder -- the module refuses Next without one -- so the box asks for one rather than
       showing the default as grey text, which would read as a value that empty gets. *@
    <FolderSwitch Role="use-output" Checked="@Module.UseOwnOutputFolder" OnChange="OnUseOutputChanged"
                  Label="Use my own output folder"
                  OnText="On: generated images and videos are saved to the folder you choose below."
                  OffText="@OutputOffText"
                  Folder="@Module.OutputFolder" FolderNoun="output folder" />

    @if (Module.UseOwnOutputFolder)
    {
        <div class="path-row switch-body">
            <input type="text" data-role="output" value="@Module.OutputFolder"
                   placeholder="Choose a folder for generated images and videos" @oninput="OnOutputFolderTyped" />
            <button class="btn-secondary" @onclick="BrowseOutput">Browse...</button>
        </div>
        @* Here, under the box it is about -- the page leaves this module out of its list under the
           buttons, which sits below the whole model panel and off screen on a short window. *@
        @if (Module.OutputFolderProblem is { } outputProblem)
        {
            <p class="validation-error" data-role="output-problem">@outputProblem</p>
        }
    }
</section>

<section class="panel" data-role="model-panel">
    <h2>Model folder</h2>

    @* The "use my own model folder" switch (issue #15). On when a library folder is remembered,
       off when none is. Off means ComfyUI's own models folders: nothing below it renders and no
       extra_model_paths.yaml is written. Before it existed a remembered library was applied from
       behind the collapsed Advanced section, where nobody saw it. On needs a library (the module
       refuses Next without one), so the library box sits right under the switch, as the output
       box does, not inside the collapsed Advanced section where a required field cannot hide. *@
    <FolderSwitch Role="use-library" Checked="@Module.UseModelLibraryFolder" OnChange="OnUseLibraryChanged"
                  Label="Use my own model folder"
                  OnText="On: models are read from your library through an extra_model_paths.yaml written into the install."
                  OffText="@ModelOffText"
                  Folder="@Module.ModelBaseFolder" FolderNoun="library folder" />

    @if (Module.UseModelLibraryFolder)
    {
    <div class="path-row switch-body">
        <input type="text" data-role="library" value="@Module.ModelBaseFolder"
               placeholder="Choose your model library folder" @oninput="OnModelBaseFolderTyped" />
        <button class="btn-secondary" @onclick="BrowseModels">Browse...</button>
    </div>
    @if (Module.ModelFolderProblem is { } modelProblem)
    {
        <p class="validation-error" data-role="library-problem">@modelProblem</p>
    }

    @* With the library, not in Advanced: it changes the install, and the Advanced badge speaks
       only for the folder names and additional folders, so ticked in there it went unseen. *@
    @if (!string.IsNullOrWhiteSpace(Module.ModelBaseFolder))
    {
        <label class="checkbox switch-body">
            <input type="checkbox" data-role="overwrite-yaml" checked="@Module.OverwriteExtraModelPaths" @onchange="OnOverwriteChanged" />
            Overwrite an existing extra_model_paths.yaml
        </label>
    }

    <AdvancedDisclosure Subtitle="custom model folders" Badge="@(Module.HasCustomFolders ? "custom folders in use" : null)">
        <p class="panel-hint">
            Only needed if your library uses different folder names than ComfyUI's standard ones,
            or holds extra folders. Everything here is remembered for your next install.
        </p>

        <div class="advanced-head">
            <h3>Folder names inside the library</h3>
            <button type="button" class="btn-secondary btn-small" @onclick="ResetFolderTypes">Reset to standard</button>
        </div>
        <div class="folder-grid">
            @foreach (var row in Module.FolderTypes)
            {
                <label for="folder-type-@row.Key">@row.Label</label>
                <input id="folder-type-@row.Key" type="text" data-folder-key="@row.Key"
                       value="@row.Value" placeholder="@row.Standard"
                       @oninput="e => OnFolderTypeTyped(row.Key, e)" />
            }
        </div>

        <div class="advanced-head">
            <h3>Additional folders</h3>
            <button type="button" class="btn-secondary btn-small" @onclick="AddAdditionalFolder">+ Add folder</button>
        </div>
        <p class="panel-hint">
            Extra entries for extra_model_paths.yaml beyond the standard types: the name ComfyUI
            should use and the folder it points at.
        </p>
        @foreach (var row in Module.AdditionalFolders)
        {
            <div class="additional-folder path-row" @key="row.Id">
                <input type="text" data-role="name" placeholder="ComfyUI folder name"
                       value="@row.BaseName" @oninput="e => OnAdditionalNameTyped(row, e)" />
                <input type="text" data-role="path" placeholder="Folder path"
                       value="@row.MapsTo" @oninput="e => OnAdditionalPathTyped(row, e)" />
                <button type="button" class="btn-secondary" @onclick="() => BrowseAdditional(row)">Browse...</button>
                <button type="button" class="btn-secondary btn-icon" data-role="remove" title="Remove"
                        @onclick="() => RemoveAdditionalFolder(row)">✕</button>
            </div>
        }
    </AdvancedDisclosure>
    }
</section>

@code {
    [Parameter, EditorRequired] public ComfyFoldersModule Module { get; set; } = default!;

    /// <summary>
    /// Raised after any edit. The parent owns the Next button, and Blazor re-renders only the
    /// component that owns a handler -- without this the parent's disabled state goes stale and the
    /// user can never leave the stage.
    /// </summary>
    [Parameter] public EventCallback Changed { get; set; }

    /// <summary>Names the folder off falls back to, once an install folder says where that is.</summary>
    private string OutputOffText => string.IsNullOrEmpty(Module.DefaultOutputFolder)
        ? "Off: generated images and videos stay in ComfyUI's own output folder inside the install."
        : $"Off: generated images and videos stay in ComfyUI's own output folder ({Module.DefaultOutputFolder}).";

    private string ModelOffText => string.IsNullOrEmpty(Module.DefaultModelsFolder)
        ? "Off: ComfyUI's own models folders are used and no extra_model_paths.yaml is written."
        : $"Off: ComfyUI's own models folders ({Module.DefaultModelsFolder}) are used and no extra_model_paths.yaml is written.";

    private async Task OnUseOutputChanged(bool on)
    {
        Module.UseOwnOutputFolder = on;
        await Changed.InvokeAsync();
    }

    private async Task OnUseLibraryChanged(bool on)
    {
        Module.UseModelLibraryFolder = on;
        await Changed.InvokeAsync();
    }

    private async Task OnModelBaseFolderTyped(ChangeEventArgs e)
    {
        Module.ModelBaseFolder = e.Value?.ToString() ?? string.Empty;
        await Changed.InvokeAsync();
    }

    private async Task OnOverwriteChanged(ChangeEventArgs e)
    {
        Module.OverwriteExtraModelPaths = (bool)(e.Value ?? false);
        await Changed.InvokeAsync();
    }

    private async Task OnOutputFolderTyped(ChangeEventArgs e)
    {
        Module.OutputFolder = e.Value?.ToString() ?? string.Empty;
        await Changed.InvokeAsync();
    }

    private async Task OnFolderTypeTyped(string key, ChangeEventArgs e)
    {
        Module.SetFolderType(key, e.Value?.ToString() ?? string.Empty);
        await Changed.InvokeAsync();
    }

    private async Task ResetFolderTypes()
    {
        Module.ResetFolderTypesToStandard();
        await Changed.InvokeAsync();
    }

    private async Task AddAdditionalFolder()
    {
        Module.AddAdditionalFolder();
        await Changed.InvokeAsync();
    }

    private async Task RemoveAdditionalFolder(AdditionalFolderRow row)
    {
        Module.RemoveAdditionalFolder(row);
        await Changed.InvokeAsync();
    }

    private async Task OnAdditionalNameTyped(AdditionalFolderRow row, ChangeEventArgs e)
    {
        row.BaseName = e.Value?.ToString() ?? string.Empty;
        await Changed.InvokeAsync();
    }

    private async Task OnAdditionalPathTyped(AdditionalFolderRow row, ChangeEventArgs e)
    {
        row.MapsTo = e.Value?.ToString() ?? string.Empty;
        await Changed.InvokeAsync();
    }

    private async Task BrowseModels()
    {
        var chosen = await FolderPicker.PickFolderAsync("Select your model library folder", Module.ModelBaseFolder);
        if (chosen is null) return;          // dismissed -- leave the field untouched

        Module.ModelBaseFolder = chosen;
        await Changed.InvokeAsync();
    }

    private async Task BrowseOutput()
    {
        var chosen = await FolderPicker.PickFolderAsync("Select the output folder", Module.OutputFolder);
        if (chosen is null) return;          // dismissed -- leave the field untouched

        Module.OutputFolder = chosen;
        await Changed.InvokeAsync();
    }

    private async Task BrowseAdditional(AdditionalFolderRow row)
    {
        var chosen = await FolderPicker.PickFolderAsync("Select the folder to add", row.MapsTo);
        if (chosen is null) return;          // dismissed -- leave the field untouched

        row.MapsTo = chosen;
        await Changed.InvokeAsync();
    }
}
