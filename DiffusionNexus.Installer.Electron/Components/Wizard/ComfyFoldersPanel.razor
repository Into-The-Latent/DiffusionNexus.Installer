@using DiffusionNexus.Installer.Core.Host
@using DiffusionNexus.Installer.Core.Modules
@inject IFolderPicker FolderPicker

<section class="panel">
    <h2>Model and output folders</h2>

    @if (Module.SupportsOutputFolder)
    {
        <label>Output folder <span class="panel-hint">(optional)</span></label>
        <p class="panel-hint">Leave empty to keep generated images and videos inside the install.</p>
        <div class="path-row">
            <input type="text" data-role="output" value="@Module.OutputFolder"
                   placeholder="@Module.DefaultOutputFolder" @oninput="OnOutputFolderTyped" />
            <button class="btn-secondary" @onclick="BrowseOutput">Browse...</button>
        </div>
    }

    <button type="button" class="advanced-toggle" @onclick="ToggleAdvanced" aria-expanded="@(_advancedOpen ? "true" : "false")">
        <span class="advanced-chevron">@(_advancedOpen ? "▾" : "▸")</span>
        Advanced: custom model folders
        @if (Module.HasCustomFolders)
        {
            <span class="tag">custom folders in use</span>
        }
    </button>

    @if (_advancedOpen)
    {
        <div class="advanced">
            <p class="panel-hint">
                Only needed if you keep models outside the install, or your library uses different
                folder names than ComfyUI's standard ones. Everything here is remembered for your
                next install.
            </p>

            <label>Model library folder <span class="panel-hint">(optional)</span></label>
            <p class="panel-hint">
                Leave empty to keep models inside the install. Point it at an existing library and the
                installer writes an <code>extra_model_paths.yaml</code> so the software reads from it
                instead of downloading again.
            </p>
            <div class="path-row">
                <input type="text" data-role="library" value="@Module.ModelBaseFolder"
                       placeholder="@Module.DefaultModelsFolder" @oninput="OnModelBaseFolderTyped" />
                <button class="btn-secondary" @onclick="BrowseModels">Browse...</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(Module.ModelBaseFolder))
            {
                <label class="checkbox">
                    <input type="checkbox" checked="@Module.OverwriteExtraModelPaths" @onchange="OnOverwriteChanged" />
                    Overwrite an existing extra_model_paths.yaml
                </label>
            }

            <div class="advanced-head">
                <h3>Folder names inside the library</h3>
                <button type="button" class="btn-secondary btn-small" @onclick="ResetFolderTypes">Reset to standard</button>
            </div>
            <div class="folder-grid">
                @foreach (var row in Module.FolderTypes)
                {
                    <label for="folder-type-@row.Key">@row.Label</label>
                    <input id="folder-type-@row.Key" type="text" data-folder-key="@row.Key"
                           value="@row.Value" placeholder="@row.Standard"
                           @oninput="e => OnFolderTypeTyped(row.Key, e)" />
                }
            </div>

            <div class="advanced-head">
                <h3>Additional folders</h3>
                <button type="button" class="btn-secondary btn-small" @onclick="AddAdditionalFolder">+ Add folder</button>
            </div>
            <p class="panel-hint">
                Extra entries for extra_model_paths.yaml beyond the standard types: the name ComfyUI
                should use and the folder it points at.
            </p>
            @foreach (var row in Module.AdditionalFolders)
            {
                <div class="additional-folder path-row" @key="row.Id">
                    <input type="text" data-role="name" placeholder="ComfyUI folder name"
                           value="@row.BaseName" @oninput="e => OnAdditionalNameTyped(row, e)" />
                    <input type="text" data-role="path" placeholder="Folder path"
                           value="@row.MapsTo" @oninput="e => OnAdditionalPathTyped(row, e)" />
                    <button type="button" class="btn-secondary" @onclick="() => BrowseAdditional(row)">Browse...</button>
                    <button type="button" class="btn-secondary btn-icon" data-role="remove" title="Remove"
                            @onclick="() => RemoveAdditionalFolder(row)">✕</button>
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public ComfyFoldersModule Module { get; set; } = default!;

    /// <summary>
    /// Raised after any edit. The parent owns the Next button, and Blazor re-renders only the
    /// component that owns a handler -- without this the parent's disabled state goes stale and the
    /// user can never leave the stage.
    /// </summary>
    [Parameter] public EventCallback Changed { get; set; }

    private bool _advancedOpen;

    private void ToggleAdvanced() => _advancedOpen = !_advancedOpen;

    private async Task OnModelBaseFolderTyped(ChangeEventArgs e)
    {
        Module.ModelBaseFolder = e.Value?.ToString() ?? string.Empty;
        await Changed.InvokeAsync();
    }

    private async Task OnOverwriteChanged(ChangeEventArgs e)
    {
        Module.OverwriteExtraModelPaths = (bool)(e.Value ?? false);
        await Changed.InvokeAsync();
    }

    private async Task OnOutputFolderTyped(ChangeEventArgs e)
    {
        Module.OutputFolder = e.Value?.ToString() ?? string.Empty;
        await Changed.InvokeAsync();
    }

    private async Task OnFolderTypeTyped(string key, ChangeEventArgs e)
    {
        Module.SetFolderType(key, e.Value?.ToString() ?? string.Empty);
        await Changed.InvokeAsync();
    }

    private async Task ResetFolderTypes()
    {
        Module.ResetFolderTypesToStandard();
        await Changed.InvokeAsync();
    }

    private async Task AddAdditionalFolder()
    {
        Module.AddAdditionalFolder();
        await Changed.InvokeAsync();
    }

    private async Task RemoveAdditionalFolder(AdditionalFolderRow row)
    {
        Module.RemoveAdditionalFolder(row);
        await Changed.InvokeAsync();
    }

    private async Task OnAdditionalNameTyped(AdditionalFolderRow row, ChangeEventArgs e)
    {
        row.BaseName = e.Value?.ToString() ?? string.Empty;
        await Changed.InvokeAsync();
    }

    private async Task OnAdditionalPathTyped(AdditionalFolderRow row, ChangeEventArgs e)
    {
        row.MapsTo = e.Value?.ToString() ?? string.Empty;
        await Changed.InvokeAsync();
    }

    private async Task BrowseModels()
    {
        var chosen = await FolderPicker.PickFolderAsync("Select your model library folder", Module.ModelBaseFolder);
        if (chosen is null) return;          // dismissed -- leave the field untouched

        Module.ModelBaseFolder = chosen;
        await Changed.InvokeAsync();
    }

    private async Task BrowseOutput()
    {
        var chosen = await FolderPicker.PickFolderAsync("Select the output folder", Module.OutputFolder);
        if (chosen is null) return;          // dismissed -- leave the field untouched

        Module.OutputFolder = chosen;
        await Changed.InvokeAsync();
    }

    private async Task BrowseAdditional(AdditionalFolderRow row)
    {
        var chosen = await FolderPicker.PickFolderAsync("Select the folder to add", row.MapsTo);
        if (chosen is null) return;          // dismissed -- leave the field untouched

        row.MapsTo = chosen;
        await Changed.InvokeAsync();
    }
}
