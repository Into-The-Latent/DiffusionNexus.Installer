@using DiffusionNexus.Installer.Core.Host
@using DiffusionNexus.Installer.Core.Modules
@implements IDisposable
@inject IFolderPicker FolderPicker

<section class="panel">
    <h2>Install location</h2>
    <p class="panel-hint">Where the software gets installed.</p>
    @if (Module.IsCheckingFolder)
    {
        <p class="panel-hint folder-check">Checking this folder...</p>
    }
    else if (Module.Validate() is { IsValid: false, ErrorMessage: { } problem })
    {
        @* Shown here, next to the box it is about; the page skips this module in its own list. *@
        <p class="validation-error">@problem</p>
        @if (Module.FolderCheckTimedOut)
        {
            <button class="btn-secondary folder-retry" @onclick="TryAgain">Try again</button>
        }
    }
    <div class="path-row">
        <input type="text" value="@Module.TargetFolder" @oninput="OnFolderTyped" />
        <button class="btn-secondary" @onclick="Browse">Browse...</button>
    </div>
    @if (Module.DestinationFolder is { } destination)
    {
        <p class="destination">Will be created: <code>@destination</code></p>
    }
</section>

@code {
    [Parameter, EditorRequired] public InstallFolderModule Module { get; set; } = default!;

    /// <summary>
    /// Raised after any edit. The parent owns the Next button, and Blazor re-renders only the
    /// component that owns a handler -- without this the parent's disabled state goes stale and the
    /// user can never leave the stage.
    /// </summary>
    [Parameter] public EventCallback Changed { get; set; }

    protected override void OnInitialized() => Module.FolderCheckAnswered += OnFolderCheckAnswered;

    // The page too: it owns Next, and Blazor re-renders only the component that owns a handler.
    private void OnFolderCheckAnswered() => _ = InvokeAsync(async () =>
    {
        await Changed.InvokeAsync();
        StateHasChanged();
    });

    public void Dispose() => Module.FolderCheckAnswered -= OnFolderCheckAnswered;

    private async Task TryAgain()
    {
        Module.CheckFolderAgain();
        await Changed.InvokeAsync();
    }

    private async Task OnFolderTyped(ChangeEventArgs e)
    {
        Module.TargetFolder = e.Value?.ToString() ?? string.Empty;
        await Changed.InvokeAsync();
    }

    private async Task Browse()
    {
        var chosen = await FolderPicker.PickFolderAsync("Select the install folder", Module.TargetFolder);
        if (chosen is null) return;          // dismissed -- leave the field untouched

        Module.TargetFolder = chosen;
        await Changed.InvokeAsync();
    }
}
