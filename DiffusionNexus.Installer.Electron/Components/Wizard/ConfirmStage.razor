@using DiffusionNexus.Installer.Core.Modules
@using DiffusionNexus.Installer.Core.Wizard

@{
    // Runs every module's Contribute, which is also what populates Selection.TargetFolder --
    // so it must run before the summary below reads it, or the folder row renders blank on the
    // first visit to this screen.
    var options = Run.Plan.ToOptions();
    var models = Run.Plan.AllModules.OfType<ModelSelectionModule>().FirstOrDefault();
    var workflows = Run.Plan.AllModules.OfType<WorkflowSelectionModule>().FirstOrDefault();
    var selection = Run.Plan.Selection;
    var modelsOnly = selection.Mode == WizardMode.ModelsOnly;
    var update = selection.Mode == WizardMode.UpdateExisting;
}

<section class="panel">
    <h2>@(modelsOnly ? "Ready to download" : update ? "Ready to update" : "Ready to install")</h2>

    <dl class="summary">
        @* Each chosen version, as a last chance to catch a wrong size: Select multiple starts at 32 GB,
           so anyone who ignored its selector gets the largest downloads. *@
        @if (selection.IsMultiple)
        {
            <dt>Workloads</dt>
            <dd>
                @foreach (var choice in selection.Choices)
                {
                    <span class="summary-line" data-role="version">@choice.Workload.Name: @(choice.VramGb > 0 ? $"{choice.VramGb} GB" : "one version only")</span>
                }
            </dd>
        }
        else if (selection.UpdateOnly)
        {
            <dt>Workloads</dt>
            <dd data-role="no-workloads">None. This only updates ComfyUI.</dd>
        }
        else
        {
            <dt>Workload</dt>
            <dd>@selection.Workload.Name</dd>
        }

        @if (update)
        {
            <dt>ComfyUI folder</dt>
            <dd>@selection.TargetFolder</dd>

            <dt>ComfyUI update</dt>
            <dd data-role="comfy-update">@(options.Extend is { RunUpdate: true } ? "On" : "Off")</dd>
        }
        else if (modelsOnly)
        {
            <dt>Download folder</dt>
            <dd>@Run.Plan.Selection.TargetFolder</dd>

            <dt>Subfolders</dt>
            <dd data-role="subfolders">@(Run.Plan.Selection.SortModelsIntoSubfolders ? "On: models are sorted into subfolders" : "Off: every file goes directly into the folder")</dd>
        }
        else
        {
            <dt>Software</dt>
            <dd>@Run.Plan.Selection.Workload.Repository.Type</dd>

            <dt>Install folder</dt>
            <dd>@Run.Plan.Selection.TargetFolder</dd>

            <dt>Python</dt>
            <dd>@Run.Plan.Selection.Workload.Python.PythonVersion</dd>
        }

        @if (options.SelectedVramProfile > 0)
        {
            <dt>VRAM tier</dt>
            <dd>@options.SelectedVramProfile GB</dd>
        }

        @if (models is not null)
        {
            <dt>Models</dt>
            <dd>@models.SelectedCount of @models.Rows.Count selected</dd>
        }

        @if (workflows is not null)
        {
            <dt>Workflows</dt>
            <dd>@workflows.SelectedCount of @workflows.Rows.Count selected</dd>
        }

        @if (options.ModelBaseFolder is not null)
        {
            <dt>Model library</dt>
            <dd>@options.ModelBaseFolder</dd>
        }

        @if (options.OutputFolder is not null)
        {
            <dt>Output folder</dt>
            <dd>@options.OutputFolder</dd>
        }

        @if (options.CpuTorch)
        {
            <dt>Torch</dt>
            <dd>CPU-only build</dd>
        }

        @if (!modelsOnly && !update)
        {
            <dt>Shortcuts</dt>
            <dd>
                @(options.CreateDesktopShortcut ? "Desktop" : null)
                @(options.CreateDesktopShortcut && options.CreateStartMenuShortcut ? " + " : null)
                @(options.CreateStartMenuShortcut ? "Start Menu" : null)
                @(!options.CreateDesktopShortcut && !options.CreateStartMenuShortcut ? "None" : null)
            </dd>
        }
    </dl>
</section>

@code {
    [Parameter, EditorRequired] public WizardRun Run { get; set; } = default!;
}
