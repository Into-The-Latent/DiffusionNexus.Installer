@using DiffusionNexus.Installer.Core.Gallery
@using DiffusionNexus.Installer.Core.Wizard
@using DiffusionNexus.Installer.Electron.Components.Shared
@using DiffusionNexus.Installer.Electron.Services
@using DiffusionNexus.Installer.SDK.Models.Configuration

@* "Did I click the right thing?" answered before anything is asked of the user.

   Shown at the top of the first wizard stage. It repeats the picture the user clicked one
   navigation ago at size, next to what the catalog says the workload actually does. *@

<section class="hero">
    <div class="hero-art">
        @* The picture the user clicked one navigation ago, so it is the one that confirms the
           choice: the workload's own thumbnail when it was picked from a workload screen, the
           SOFTWARE logo when the welcome tile came straight here. *@
        @if (FromWorkloadScreen && Workload.ThumbnailPath is not null)
        {
            @* Through the endpoint, never the disk path: ThumbnailPath is absolute and
               unloadable in a browser. A 404 leaves the alt text, which is the workload name. *@
            <img src="thumbnail/@Workload.Id" alt="@Workload.Name" />
        }
        else if (SoftwareLogos.PathFor(Workload.Repository.Type) is { } logo)
        {
            <img src="@logo" alt="@SoftwareName" />
        }
        else
        {
            <span class="hero-art-fallback">@SoftwareName</span>
        }
    </div>

    <div class="hero-text">
        @* Suppressed when it would merely repeat the heading. Fooocus's single workload is called
           "Fooocus"; A1111's is called "Stable Diffusion web UI", and there the eyebrow is the
           only thing tying the screen back to the tile labelled "Automatic 1111". *@
        @if (!string.Equals(SoftwareName, Workload.Name, StringComparison.CurrentCultureIgnoreCase))
        {
            <p class="hero-software">@SoftwareName</p>
        }

        @* The version only where one software offers many workloads: that is where "which
           revision of this pack am I installing?" is a real question. Same shape as the card the
           user just clicked -- version on the name, VRAM as a chip. *@
        @* One line and a no-break space: the version wraps with the name's last word. *@
        <h1 class="hero-name">@(Workload.Name)@if (FromWorkloadScreen) {<text>&nbsp;</text><span class="workload-version">@WorkloadVersion.Display(Workload)</span>}</h1>

        @if (FromWorkloadScreen && VramTiers.RangeText(Workload.Vram.VramProfiles) is { } vram)
        {
            <p class="hero-tags"><span class="vram-chip">@vram</span></p>
        }

        <div class="hero-desc">
            <MarkdownText Text="@Workload.Description" />
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public InstallationConfiguration Workload { get; set; } = default!;

    /// <summary>
    /// True when the user picked this workload from its software's workload screen (ComfyUI),
    /// false when the welcome tile came straight to the wizard.
    /// </summary>
    [Parameter] public bool FromWorkloadScreen { get; set; }

    private string SoftwareName => SoftwareBranding.DisplayName(Workload.Repository.Type);
}
