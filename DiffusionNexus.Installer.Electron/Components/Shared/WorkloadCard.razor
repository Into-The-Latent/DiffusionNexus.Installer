@using DiffusionNexus.Installer.Core.Gallery
@using DiffusionNexus.Installer.Core.Wizard

@* The catalog ships a description for every workload and the tile has no room for it, so it goes
   on the title: hovering a card is the only place in the app the text is now reachable. Null when
   blank -- Blazor omits an attribute whose value is null, and an empty tooltip is worse than none. *@
<div class="workload-card @(Entry.IsInstallable ? "" : "workload-card-disabled")" title="@Description">
    <div class="card-art workload-card-art">
        @if (Entry.Workload.ThumbnailPath is not null)
        {
            @* Through the endpoint, never the disk path: ThumbnailPath is absolute and
               unloadable in a browser. A 404 leaves the alt text, which is the workload name. *@
            <img src="thumbnail/@Entry.Workload.Id" alt="@Entry.Workload.Name" loading="lazy" />
        }
        else
        {
            <span class="workload-card-art-fallback">@Entry.Workload.Name</span>
        }
    </div>

    <div class="workload-card-meta">
        @* The version rides on the name, the way a package's does: it is part of WHAT this is,
           not a fact about it, and inline it wraps with a long name instead of needing a row.
           One line and a no-break space, deliberately: the version then wraps together with the
           name's last word, and can never be left alone on a line of its own. *@
        <p class="workload-card-name">@Entry.Workload.Name&nbsp;<span class="workload-version">@WorkloadVersion.Display(Entry.Workload)</span></p>

        <div class="workload-card-tags">
            <span class="workload-card-badge">@Entry.Workload.WorkflowType</span>
            @* Only for a pack that declares VRAM profiles: the span of them, so a card can be
               ruled in or out before the wizard is opened. *@
            @if (VramTiers.RangeText(Entry.Workload.Vram.VramProfiles) is { } vram)
            {
                <span class="vram-chip">@vram</span>
            }
            @* Only on screen once the workload screen's "Show legacy workloads" switch is on, next
               to the packs that superseded it -- this is what tells the two apart. *@
            @if (Entry.Workload.IsLegacy)
            {
                <span class="legacy-chip">Legacy</span>
            }
        </div>

        @if (Selectable)
        {
            @* A version that doesn't fit never greys out the card: people wouldn't know why. *@
            @if (Versions.Count > 0)
            {
                <label class="workload-card-version">
                    <span>Version</span>
                    <select value="@Version" @onchange="OnVersionPicked">
                        @foreach (var tier in Versions)
                        {
                            <option value="@tier">@tier GB</option>
                        }
                    </select>
                </label>
            }
            else
            {
                <p class="workload-card-one-version">One version only</p>
            }
            @if (Note is not null)
            {
                <p class="validation-error" data-role="too-large">@Note</p>
            }
            <label class="workload-card-include">
                <input type="checkbox" data-role="include" checked="@Included" @onchange="OnIncludeChanged" />
                <span>Include</span>
            </label>
        }
        else if (Entry.IsInstallable)
        {
            <button class="workload-card-install" type="button" @onclick="() => OnInstall.InvokeAsync(Entry)">
                @ActionLabel
            </button>
        }
        else
        {
            <p class="card-unavailable workload-card-unavailable">@Entry.UnavailableReason</p>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public GalleryEntry Entry { get; set; } = default!;

    /// <summary>Raised with this card's entry when the user chooses to install it.</summary>
    [Parameter] public EventCallback<GalleryEntry> OnInstall { get; set; }

    /// <summary>What the button says.</summary>
    [Parameter] public string ActionLabel { get; set; } = "Install";

    /// <summary>Select multiple: an Include checkbox and a version instead of the button.</summary>
    [Parameter] public bool Selectable { get; set; }

    [Parameter] public bool Included { get; set; }

    [Parameter] public EventCallback<bool> IncludedChanged { get; set; }

    /// <summary>The workload's versions in GB. Empty for "One version only".</summary>
    [Parameter] public IReadOnlyList<int> Versions { get; set; } = [];

    [Parameter] public int Version { get; set; }

    [Parameter] public EventCallback<int> VersionChanged { get; set; }

    /// <summary>The red note under the version, when it's too large.</summary>
    [Parameter] public string? Note { get; set; }

    private Task OnVersionPicked(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var version) ? VersionChanged.InvokeAsync(version) : Task.CompletedTask;

    private Task OnIncludeChanged(ChangeEventArgs e) => IncludedChanged.InvokeAsync(e.Value is true);

    /// <summary>The catalog's own description, or null when it has none worth showing.</summary>
    private string? Description => string.IsNullOrWhiteSpace(Entry.Workload.Description)
        ? null
        : Entry.Workload.Description;
}
