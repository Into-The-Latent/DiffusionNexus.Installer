@page "/install/{WorkloadId:guid}"
@using DiffusionNexus.Installer.Core.Catalog
@using DiffusionNexus.Installer.Core.Host
@using DiffusionNexus.Installer.Core.Install
@using DiffusionNexus.Installer.Core.Modules
@using DiffusionNexus.Installer.Core.Wizard
@using DiffusionNexus.Installer.Electron.Components.Wizard
@using DiffusionNexus.Installer.SDK.Models.Enums
@using DiffusionNexus.Installer.SDK.Services
@inject IWorkloadSource Workloads
@inject WizardModuleRegistry Registry
@inject IInstallSession Session
@inject IUserPrompt Prompt
@inject NavigationManager Nav

<PageTitle>Install</PageTitle>

@if (_busyWith is not null)
{
    <section class="panel panel-warning">
        <h1>Another installation is running</h1>
        <p>
            <strong>@_busyWith</strong> is still installing. Only one installation can run at a
            time, so this one cannot be started yet.
        </p>
        <div class="wizard-actions">
            <button class="btn-secondary" @onclick="GoToGallery">Back to workloads</button>
            <button class="btn-primary" @onclick="ResumeRunning">Show the running install</button>
        </div>
    </section>
}
else if (_run is null)
{
    <p>Preparing...</p>
}
else
{
    <h1>@_run.Plan.Selection.Workload.Name</h1>
    <ol class="stage-strip">
        @foreach (var stage in _run.Plan.Stages)
        {
            <li class="@(stage == _run.CurrentStage ? "stage-current" : "stage")">@stage</li>
        }
    </ol>

    @if (_run.CurrentStage == WizardStage.Install)
    {
        <InstallStage Run="_run" />

        @* The only way out of a finished install. Without it an Electron user -- no address bar,
           no menu -- has to kill the process to install a second workload. *@
        @if (Session.Phase is not InstallPhase.Running)
        {
            <div class="wizard-actions">
                <button class="btn-primary" @onclick="GoToGallery">Back to workloads</button>
            </div>
        }
    }
    else
    {
        @if (_run.CurrentStage == WizardStage.Confirm)
        {
            <ConfirmStage Run="_run" />
        }

        @* Confirm-stage modules render after the summary: the disclaimer belongs below what it
           applies to, and nothing else targets that stage today. *@
        @foreach (var module in _run.CurrentModules)
        {
            @RenderModule(module)
        }

        <div class="wizard-actions">
            @* Always available, including at stage 0. A GPU-blocked System stage validates false
               forever, and with Back disabled at index 0 there would be no exit from the wizard. *@
            <button class="btn-secondary" @onclick="GoToGallery">Cancel</button>
            <button class="btn-secondary" disabled="@(!_run.CanGoBack)" @onclick="Back">Back</button>
            <button class="btn-primary" disabled="@(!_run.CanGoNext)" @onclick="Next">Next</button>
        </div>

        @foreach (var error in _run.ValidationErrors)
        {
            <p class="validation-error">@error</p>
        }
    }
}

@code {
    [Parameter] public Guid WorkloadId { get; set; }

    private WizardRun? _run;
    private string? _busyWith;
    private EventCallback _moduleChanged;

    protected override async Task OnInitializedAsync()
    {
        // Blazor only re-renders the component that owns an event handler. Every panel is a child
        // component, so without an explicit callback back up to this page, an edit inside a panel
        // (typing a folder, ticking a checkbox) never refreshes this page's disabled="@(!_run.CanGoNext)".
        _moduleChanged = EventCallback.Factory.Create(this, StateHasChanged);

        if (Session.Phase == InstallPhase.Running && Session.Plan is { } running)
        {
            // A circuit reconnect rebuilds this component while the install keeps running in the
            // singleton session. Rejoin that run rather than starting the wizard over, which would
            // hide the install and reset the answers the user already gave.
            if (running.Selection.Workload.Id == WorkloadId)
            {
                _run = new WizardRun(running, WizardStage.Install);
                return;
            }

            // A DIFFERENT workload is installing. Building a wizard for this one would walk the
            // user to an Install stage that silently starts nothing and then reports the other
            // install's progress, log and success banner under this workload's name.
            _busyWith = running.Selection.Workload.Name;
            return;
        }

        var workloads = await Workloads.GetInstallerWorkloadsAsync();
        var workload = workloads.FirstOrDefault(w => w.Id == WorkloadId);

        if (workload is null)
        {
            Nav.NavigateTo("/");
            return;
        }

        var plan = await Registry.BuildPlanAsync(new WizardSelection { Workload = workload });

        // Without this the SDK's OnShortcutConflict callback is always null and a name clash is
        // silently overwritten -- wire it to a user prompt before the run starts so a conflict
        // mid-install can actually ask.
        if (plan.AllModules.OfType<ShortcutsModule>().FirstOrDefault() is { } shortcuts)
        {
            shortcuts.OnShortcutConflict = async (name, location) =>
            {
                // The session's run token, not default: ShortcutManager awaits this callback with
                // no token of its own, so a Cancel while the dialog is open would otherwise leave
                // the pipeline thread parked on an answer that can never arrive. Cancelling
                // completes it false, which maps to "skip the shortcut" -- a safe answer.
                var overwrite = await Prompt.ConfirmAsync(
                    "Shortcut already exists",
                    $"A shortcut named \"{name}\" already exists in {location}. Replace it?",
                    "Replace",
                    "Keep the existing one",
                    Session.RunToken);

                return new ShortcutConflictResult(
                    overwrite ? ShortcutConflictResolution.Overwrite : ShortcutConflictResolution.Cancel);
            };
        }

        _run = new WizardRun(plan);
    }

    private void Next() => _run!.TryNext();

    private void Back() => _run!.Back();

    private void GoToGallery() => Nav.NavigateTo("/");

    private void ResumeRunning()
    {
        if (Session.Plan is not { } running) return;

        Nav.NavigateTo($"/install/{running.Selection.Workload.Id}");
    }

    private RenderFragment RenderModule(IWizardModule module) => module switch
    {
        InstallFolderModule m => @<InstallFolderPanel Module="m" Changed="_moduleChanged" />,
        ComfyFoldersModule m => @<ComfyFoldersPanel Module="m" Changed="_moduleChanged" />,
        GpuPreflightModule m => @<GpuPreflightPanel Module="m" Changed="_moduleChanged" />,
        VcRuntimeModule m => @<VcRuntimePanel Module="m" Changed="_moduleChanged" />,
        LlamaCppModule m => @<LlamaCppPanel Module="m" />,
        ShortcutsModule m => @<ShortcutsPanel Module="m" Changed="_moduleChanged" />,
        DisclaimerModule m => @<DisclaimerPanel Module="m" Changed="_moduleChanged" />,
        _ => @<p>Unknown module: @module.Id</p>
    };
}
