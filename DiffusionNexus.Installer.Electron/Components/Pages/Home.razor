@page "/updates"
@using DiffusionNexus.Installer.Core.Install
@using DiffusionNexus.Installer.Electron.Services
@using ElectronNET.API
@using System.Globalization
@using DiffusionNexus.Installer.Core.Updates
@using DiffusionNexus.Installer.SDK.Catalog.Packaging
@using DiffusionNexus.Installer.SDK.Catalog.Updates
@inject UpdaterLog Log
@inject IInstallSession Session
@inject ICatalogUpdateCoordinator Catalog
@inject AppUpdateChecker AppUpdates
@implements IDisposable

<PageTitle>Into the Latent Easy Installer</PageTitle>

<div class="shell">
    <header>
        <h1>Into the Latent Easy Installer</h1>
        <p class="host">@HostDescription</p>
        <p><a href="/">Back to all software</a></p>
    </header>

    @* One setting drives both the app and the catalog, so it is offered once, above both rows --
       two "Following: Stable" lines in two sections read as two settings that could disagree.
       Our words, Stable / Preview -- never electron-updater's "latest" / "beta". *@
    <section class="update-channel">
        <h2>Update channel</h2>

        @foreach (var channel in new[] { CatalogChannel.Stable, CatalogChannel.Preview })
        {
            @* Keyed on the refusal count: after a switch that did not happen, "checked" renders the
               same values as before, so Blazor's diff patches nothing and the browser keeps the dot
               where the user clicked. A new key makes it rebuild the inputs from what is in effect. *@
            <label class="catalog-channel-option" @key="(channel, _radioGeneration)">
                <input type="radio" name="update-channel" value="@channel"
                       checked="@(Catalog.Channel == channel)"
                       disabled="@(EnvironmentPinned || CatalogBusy || _busy)"
                       @onchange="() => SetChannelAsync(channel)" />
                @channel
            </label>
        }

        <p class="panel-hint">
            Preview gets new installer builds and catalog content before everyone else. Switching
            back to Stable keeps a newer Preview build of the app until Stable catches up.
        </p>

        @if (EnvironmentPinned)
        {
            <p class="panel-hint">Set by DIFFUSIONNEXUS_CATALOG_CHANNEL for this run; the saved setting is not in effect.</p>
        }

        @if (_channelError is not null)
        {
            <p class="validation-error">@_channelError</p>
        }
    </section>

    <section class="catalog">
        <div class="update-row">
            <span class="update-row-label">App</span>
            <span class="update-row-version app-version">v@(AppVersion.Display)</span>
            <span class="update-row-status app-status">@AppStatusText</span>
        </div>
        <div class="update-row">
            <span class="update-row-label">Catalog</span>
            <span class="update-row-version catalog-installed">@InstalledText</span>
            <span class="update-row-status catalog-outcome">
                @OutcomeText
                @if (Catalog.Phase == CatalogUpdatePhase.Applied)
                {
                    <a href="/">Back to all software</a>
                }
            </span>
        </div>

        <div class="actions">
            <button class="primary" @onclick="CheckForUpdatesAsync" disabled="@_busy">
                @(_busy ? "Checking..." : "Check for updates")
            </button>

            @* Never offered while an install is running. QuitAndInstall closes the app and swaps its
               own binary; doing that mid-install abandons a half-written install folder -- a clone
               with no venv, a venv with no torch, a model download stopped part-way -- and this page
               is now one click from every wizard stage, because the top bar rides along with them. *@
            @if (Log.UpdateReady && !InstallRunning)
            {
                <button class="primary install" @onclick="InstallUpdate">Restart and install</button>
            }
        </div>

        @if (Log.UpdateReady && InstallRunning)
        {
            <p class="panel-hint">
                An update is ready. It can be installed once <strong>@RunningWorkload</strong> has
                finished &mdash; applying it now would restart the app mid-install and leave that
                folder unfinished.
            </p>
        }

        @if (Catalog.UpdateAvailable && Catalog.LastCheck is { } available && Catalog.Phase != CatalogUpdatePhase.Checking)
        {
            var rows = CatalogChangeRows.Build(available);
            foreach (var group in new[] { ChangeKind.Added, ChangeKind.Updated, ChangeKind.Removed })
            {
                var inGroup = rows.Where(r => r.Change == group).ToList();
                if (inGroup.Count == 0) continue;
                <div class="catalog-changes">
                    <h3>@group</h3>
                    <ul>
                        @foreach (var row in inGroup)
                        {
                            <li>
                                <span class="catalog-change-kind">@row.Kind</span>
                                <span class="catalog-change-name">@row.Name</span>
                                <span class="catalog-change-version">@row.VersionText</span>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (Catalog.Phase == CatalogUpdatePhase.Applying)
            {
                <p class="catalog-progress">@ProgressText</p>
            }
            else if (Catalog.ApplyBlockedReason is { } blocked)
            {
                @* Same rule as "Restart and install" above: never swap content under a running plan. *@
                <p class="panel-hint">@blocked</p>
            }
            else
            {
                <button class="primary" @onclick="ApplyCatalogAsync" disabled="@(!Catalog.CanApply)">Apply catalog update</button>
            }

            @if (Catalog.LastApply is { } failed && (failed.Error is not null || failed.Failed != CatalogSections.None))
            {
                <p class="catalog-error">@ApplyFailureText(failed)</p>
            }
        }
    </section>

    <section class="log">
        <h2>Updater log</h2>
        @if (Log.Lines.Count == 0)
        {
            <p class="empty">Nothing yet.</p>
        }
        else
        {
            <ul>
                @foreach (var line in Log.Lines)
                {
                    <li>@line</li>
                }
            </ul>
        }
    </section>
</div>

@code {
    private bool _busy;
    private string? _channelError;
    private int _radioGeneration;

    private static bool ElectronActive => ElectronHost.IsActive;

    private static string HostDescription => ElectronActive
        ? "Running inside the Electron shell."
        : "Running as a plain web app - the app updater is unavailable outside Electron; the catalog check still works.";

    private bool EnvironmentPinned => Catalog.ChannelSource == CatalogChannelSource.Environment;

    // _busy as well, on the radios: the catalog check finishes fast, the app check (feed read,
    // pin, electron) does not, and a second switch in between starts a check under a running one.
    // The coordinator refuses a switch in these phases (the startup check included), so the
    // radios say so up front instead of accepting a click that will not take.
    private bool CatalogBusy => Catalog.Phase is CatalogUpdatePhase.Checking or CatalogUpdatePhase.Applying;

    protected override void OnInitialized()
    {
        Log.Changed += OnLogChanged;

        // Also the session: the notice below says "wait until X has finished", and without this it
        // would still say it after X finished, with the user sitting on this page watching nothing
        // happen.
        Session.Changed += OnLogChanged;
        Catalog.Changed += OnLogChanged;
    }

    // Fires on Electron's socket thread, so hop back onto the circuit before re-rendering.
    private void OnLogChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task CheckForUpdatesAsync()
    {
        _busy = true;
        try
        {
            // Both checks from one button, on one channel. Neither throws; the app one is a
            // no-op outside Electron.
            var catalog = Catalog.CheckAsync();
            await AppUpdates.CheckAsync();
            await catalog;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetChannelAsync(CatalogChannel channel)
    {
        _channelError = null;
        try
        {
            await Catalog.SetChannelAsync(channel);
        }
        catch (Exception ex)
        {
            // An escaped exception here replaces the page with the Blazor error banner, which is a
            // worse outcome than a message under the radios that still work afterwards.
            _channelError = $"The channel could not be saved: {ex.Message}";
        }

        // A refusal is a silent no-op on the coordinator's side (no Changed), and a failed save
        // leaves the channel where it was: either way the clicked radio is now wrong.
        if (Catalog.Channel != channel)
        {
            _radioGeneration++;
            _channelError ??= "The channel was not switched: a catalog check or update is in progress. Try again when it has finished.";
            return;
        }

        // A switch forgets the last catalog check, so both rows would otherwise sit on "Not
        // checked yet." until the user thought to press the button.
        await CheckForUpdatesAsync();
    }

    /// <summary>
    /// Whether an install is in flight. The session is a singleton, so this is true even though
    /// the wizard that started it is not the component on screen.
    /// </summary>
    private bool InstallRunning => Session.Phase == InstallPhase.Running;

    /// <summary>The workload being installed, for the notice. Falls back to a neutral phrase.</summary>
    private string RunningWorkload => Session.Plan?.Selection.Workload.Name ?? "the current install";

    private void InstallUpdate()
    {
        // Belt as well as braces: the button is not rendered while an install runs, but the click
        // could be in flight as the phase changes, and what is on the other side of this call is
        // "quit and overwrite your own binary".
        if (InstallRunning) return;

        Electron.AutoUpdater.QuitAndInstall(false, true);
    }

    // Method group, so -= removes the handler this component actually added.
    public void Dispose()
    {
        Log.Changed -= OnLogChanged;

        // The session outlives every component on the circuit, so a handler left on it keeps this
        // page alive for the life of the app.
        Session.Changed -= OnLogChanged;
        Catalog.Changed -= OnLogChanged;
    }

    // Worded like the catalog row beside it, so the two read as one list.
    private string AppStatusText => Log.Status switch
    {
        AppUpdateStatus.Unavailable => "App updates are checked only inside the Electron shell.",
        AppUpdateStatus.NotInstalledBuild => "This build is not installed, so there is no app update to check for.",
        AppUpdateStatus.Checking => "Checking the app…",
        AppUpdateStatus.UpToDate => "The app is up to date.",
        AppUpdateStatus.Downloading => $"App v{Log.Version} is available. Downloading…{(Log.DownloadPercent is { } p ? $" {p}%" : null)}",
        AppUpdateStatus.Ready => $"App v{Log.Version} is ready to install.",
        AppUpdateStatus.Failed => $"The app check failed: {Log.Error}",
        _ => "Not checked yet.",
    };

    private string InstalledText => Catalog.Installed switch
    {
        null => "unknown",
        { HighestCatalogVersion: 0 } => "not yet installed",
        var s => $"v{s.HighestCatalogVersion} ({s.Channel}), applied {(s.Workloads?.AppliedAt ?? s.Workflows?.AppliedAt)?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}",
    };

    private string OutcomeText
    {
        get
        {
            if (Catalog.Phase == CatalogUpdatePhase.Checking) return "Checking the catalog…";
            if (Catalog.Phase == CatalogUpdatePhase.Applied) return $"Catalog updated to v{Catalog.LastCheck?.Remote?.CatalogVersion}.";
            return Catalog.LastCheck switch
            {
                null => "Not checked yet.",
                { Outcome: CatalogUpdateOutcome.UpToDate } => "The catalog is up to date.",
                { Outcome: CatalogUpdateOutcome.UpdatesAvailable } c => $"Catalog v{c.Remote?.CatalogVersion} is available on {c.Channel}.",
                { Outcome: CatalogUpdateOutcome.RequiresNewerSoftware } => "This catalog update needs a newer version of the installer. Install the app update above first.",
                { Outcome: CatalogUpdateOutcome.OverrideActive } => $"Update check skipped: a local catalog override is active at {Catalog.OverridePath}.",
                { Outcome: CatalogUpdateOutcome.Failed } c => $"The catalog check failed: {c.Error}",
                _ => string.Empty,
            };
        }
    }

    private string ProgressText => Catalog.Progress switch
    {
        null => "Downloading…",
        { TotalBytes: > 0 } p => $"Downloading… {(100.0 * p.BytesReceived / p.TotalBytes.Value).ToString("F0", CultureInfo.InvariantCulture)}%",
        var p => $"Downloading… {(p.BytesReceived / 1_048_576.0).ToString("F1", CultureInfo.InvariantCulture)} MB",
    };

    private static string ApplyFailureText(CatalogApplyResult result) => result.Applied switch
    {
        CatalogSections.None => $"The catalog update failed: {result.Error?.TrimEnd('.')}. Nothing was changed.",
        CatalogSections.Workloads => $"Workloads were updated; workflows failed: {result.Error}",
        CatalogSections.Workflows => $"Workflows were updated; workloads failed: {result.Error}",
        _ => $"The catalog update reported a problem: {result.Error}",
    };

    // Never throws; a refused click (state moved on) is a no-op the next render explains.
    private Task ApplyCatalogAsync() => Catalog.ApplyAsync();
}
