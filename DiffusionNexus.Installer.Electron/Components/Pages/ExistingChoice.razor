@page "/existing"
@using DiffusionNexus.Installer.Electron.Components.Shared

<PageTitle>Easy Workload Installer - Into the Latent</PageTitle>

<ScreenShell>
    <div class="workload-screen">
        <a class="workload-screen-back" href="/">&larr; All software</a>

        <div class="workload-screen-head">
            <h1>What do you want to do?</h1>
            <p>Choose one. Nothing changes until you confirm at the end.</p>
        </div>

        <div class="choice-grid">
            <a class="choice-card" data-role="update-card" href="/existing/update">
                <h2>Update existing ComfyUI</h2>
                <p>Updates your ComfyUI and adds a workload's custom nodes, models and workflows. You choose your ComfyUI folder and we check it.</p>
            </a>

            <a class="choice-card" data-role="models-card" href="/existing/models">
                <h2>Download models only</h2>
                <p>Downloads a workload's models into any folder you choose. We don't check the folder, and nothing else is installed or changed.</p>
            </a>
        </div>
    </div>
</ScreenShell>
