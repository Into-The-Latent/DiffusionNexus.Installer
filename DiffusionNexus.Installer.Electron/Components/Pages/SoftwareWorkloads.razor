@page "/software/{Software}"
@using DiffusionNexus.Installer.Core.Catalog
@using DiffusionNexus.Installer.Core.Gallery
@using DiffusionNexus.Installer.Core.Updates
@using DiffusionNexus.Installer.Core.Wizard
@using DiffusionNexus.Installer.Electron.Components.Shared
@using DiffusionNexus.Installer.SDK.Catalog
@using DiffusionNexus.Installer.SDK.Models.Configuration
@using DiffusionNexus.Installer.SDK.Models.Enums
@using DiffusionNexus.Installer.SDK.Services.Installation.Existing
@inject SoftwareGalleryBuilder Builder
@inject IWorkloadSource Workloads
@inject NavigationManager Nav
@inject ICatalogUpdateCoordinator CatalogUpdates
@inject WorkloadPicks Picks

<PageTitle>Easy Workload Installer - Into the Latent</PageTitle>

<ScreenShell ReadUnder="_readUnder">
    <div class="workload-screen">
        @if (_loadError is not null)
        {
            @* Same way out as the not-found branch below. This page is deep-linkable and an Electron
               window refresh lands straight on it, and TopBar carries no home control, so a dead end
               here leaves the user with no address bar to escape through. *@
            <div class="software-not-found">
                <p class="gallery-error">The catalog could not be read: @_loadError</p>
                <a href="/">Back to all software</a>
            </div>
        }
        else if (!_loaded)
        {
            <p>Loading the catalog...</p>
        }
        else if (_entry is null)
        {
            <div class="software-not-found">
                @if (_errors.Count > 0)
                {
                    <p>The catalog could not be loaded:</p>
                    <ul class="gallery-error">
                        @foreach (var diagnostic in _errors)
                        {
                            <li>@diagnostic.Code: @diagnostic.Message</li>
                        }
                    </ul>
                }
                else
                {
                    <p>That software is not in the catalog.</p>
                }
                <a href="/">Back to all software</a>
            </div>
        }
        else
        {
            @if (Mode == WizardMode.FreshInstall)
            {
                <a class="workload-screen-back" href="/">&larr; All software</a>
            }
            else
            {
                <a class="workload-screen-back" href="/existing">&larr; Back</a>
            }

            <div class="workload-screen-head">
                <h1>Select workload</h1>
                <p>
                    @(Mode switch
                    {
                        WizardMode.ModelsOnly => "Choose which workload's models you want to download.",
                        WizardMode.UpdateExisting => "Choose what to add to your ComfyUI, or just update it.",
                        _ => $"Choose what you want {_entry.DisplayName} set up for. You can install more later.",
                    })
                </p>
            </div>

            <div class="filters">
                <button class="@TypeClass(null)" type="button" @onclick="() => _type = null">All</button>
                @foreach (var type in AvailableTypes())
                {
                    @* No `var captured = type` copy: foreach iteration variables have been
                       per-iteration since C# 5, so this lambda already closes over a fresh one. *@
                    <button class="@TypeClass(type)" type="button" @onclick="() => _type = type">@type</button>
                }

                @* Off whenever the screen opens, like the 1.x classic list's checkbox it replaces:
                   superseded packs stay installable without crowding the current ones. Only where
                   there is something to reveal -- a switch that changes nothing is a dead control. *@
                @if (OnThisPath(_entry.Workloads).Any(e => e.Workload.IsLegacy))
                {
                    <label class="switch filters-switch">
                        <input type="checkbox" role="switch" data-role="show-legacy"
                               checked="@_showLegacy" @onchange="OnShowLegacyChanged" />
                        <span class="switch-track" aria-hidden="true"></span>
                        <span class="switch-text">Show legacy workloads</span>
                    </label>
                }

                @if (Mode != WizardMode.FreshInstall)
                {
                    <label class="switch filters-switch">
                        <input type="checkbox" role="switch" data-role="select-multiple"
                               checked="@_selectMultiple" @onchange="OnSelectMultipleChanged" />
                        <span class="switch-track" aria-hidden="true"></span>
                        <span class="switch-text">Select multiple</span>
                    </label>
                }
            </div>

            @if (_selectMultiple)
            {
                <MemorySelector MemoryGb="_memoryGb" MemoryGbChanged="OnMemoryChanged" />
            }

            <div class="workload-grid">
                @if (Mode == WizardMode.UpdateExisting && !_selectMultiple)
                {
                    <div class="workload-card update-only-tile" data-role="update-only">
                        <div class="workload-card-meta">
                            <p class="workload-card-name">Update only</p>
                            <p class="update-only-text">Updates ComfyUI and adds no workload.</p>
                            <button class="workload-card-install" type="button" @onclick="UpdateOnly">Continue</button>
                        </div>
                    </div>
                }
                @foreach (var workload in Filtered())
                {
                    var id = workload.Workload.Id;
                    <WorkloadCard @key="id" Entry="workload" OnInstall="Install"
                                  ActionLabel="@(Mode switch { WizardMode.ModelsOnly => "Download models", WizardMode.UpdateExisting => "Choose", _ => "Install" })"
                                  Selectable="_selectMultiple"
                                  Included="_included.Contains(id)"
                                  IncludedChanged="on => OnIncluded(id, on)"
                                  Versions="WorkloadVersions.Tiers(workload.Workload)"
                                  Version="VersionOf(workload.Workload)"
                                  VersionChanged="v => _versions[id] = v"
                                  Note="@WorkloadVersions.TooLargeNote(VersionOf(workload.Workload), _memoryGb)" />
                }
            </div>

            @if (_selectMultiple)
            {
                <div class="select-multiple-bar">
                    <span data-role="selected-count">@(_included.Count == 0 ? "No workloads selected" : $"{_included.Count} selected")</span>
                    <button class="btn-primary" type="button" data-role="continue" disabled="@(_included.Count == 0)" @onclick="Continue">
                        @(_included.Count == 1 ? "Continue with 1 workload" : $"Continue with {_included.Count} workloads")
                    </button>
                </div>
            }
        }
    </div>
</ScreenShell>

@code {
    /// <summary>The RepositoryType name from the route. Not parsed into the enum by the router:
    /// an unrecognised value must render the not-found state, not a 404 or an exception.</summary>
    [Parameter] public string? Software { get; set; }

    /// <summary>Which path this screen is on. The router never sets it: ModelsOnlyWorkloads does.</summary>
    [Parameter] public WizardMode Mode { get; set; } = WizardMode.FreshInstall;

    private const int StartingMemoryGb = 32;

    private SoftwareEntry? _entry;
    private bool _loaded;
    private bool _selectMultiple;
    private int _memoryGb = StartingMemoryGb;
    private readonly HashSet<Guid> _included = [];
    private readonly Dictionary<Guid, int> _versions = [];
    private WorkflowType? _type;
    private bool _showLegacy;
    private IReadOnlyList<CatalogDiagnostic> _errors = [];
    private string? _loadError;

    /// <summary>
    /// The Software value the state below was built for. Null until the first load completes.
    /// </summary>
    private string? _loadedFor;

    // The catalog generation the grid is read under (#32). Before the read: this page reads in
    // OnParametersSetAsync, before its shell first renders, so the shell cannot take it itself.
    private long _readUnder;

    protected override async Task OnParametersSetAsync()
    {
        // Keyed on the parameter actually changing, not on merely being handed parameters again.
        // OnParametersSetAsync runs on EVERY re-supply, and rebuilding unconditionally threw the
        // user's chosen type filter away and re-read the whole catalog (a deep copy of all 25
        // workloads) each time, flashing the grid back through "Loading the catalog...". What this
        // guards is a re-supply within one component instance: a router re-render, a cascading value
        // change, a reconnect.
        //
        // It does NOT collapse the prerender/interactive pair. App.razor renders <Routes> with
        // @rendermode="InteractiveServer" and prerendering left on, so those are two separate
        // component INSTANCES -- a per-instance field cannot span them, and the catalog is still
        // read twice on a plain page load. Known and accepted: the second read is the one whose
        // result the user sees, and suppressing it would mean caching across instances (or
        // prerender: false, which costs first paint).
        if (_loaded && string.Equals(_loadedFor, Software, StringComparison.OrdinalIgnoreCase)) return;

        _loadedFor = Software;
        _readUnder = CatalogUpdates.ContentGeneration;

        // Filter state is per-software: arriving at a different software must not inherit the
        // previous one's chosen type, nor its legacy switch.
        _type = null;
        _showLegacy = false;
        _selectMultiple = false;
        _included.Clear();
        _versions.Clear();
        _entry = null;
        _loaded = false;
        _errors = [];
        _loadError = null;

        try
        {
            var all = await Builder.BuildAsync();

            // Read after the build: the catalog populates diagnostics during the load the build
            // triggers, so asking earlier reports on a catalog that has not been resolved yet.
            _errors = Workloads.Diagnostics.Where(d => d.IsError).ToList();

            if (Enum.TryParse<RepositoryType>(Software, ignoreCase: true, out var parsed))
            {
                _entry = all.FirstOrDefault(s => s.Type == parsed);
            }
        }
        catch (Exception ex)
        {
            // A catalog failure must say why the page is empty rather than take it down with an
            // unhandled exception out of the component lifecycle. This page is deep-linkable --
            // an Electron window refresh mid-flow lands here directly -- so it needs the same
            // care as the welcome screen's first load.
            _loadError = ex.Message;
        }
        finally
        {
            _loaded = true;
        }
    }

    /// <summary>
    /// What the switch lets on screen, before the type filter narrows it. Switched on, the legacy
    /// packs follow the current ones: GalleryBuilder sorts them last, so the current packs keep
    /// their places.
    /// </summary>
    private IReadOnlyList<GalleryEntry> Visible() => OnThisPath(_showLegacy ? _entry!.Workloads : _entry!.CurrentWorkloads);

    /// <summary>
    /// What this path can offer. Models only leaves out a workload with nothing to download, and
    /// offers one a fresh install refuses: what blocks that is its torch pairing or a capability
    /// the installer lacks, and a download touches neither. The update path leaves out what adds
    /// nothing to an install, and offers the rest too: whether torch changes isn't known until the
    /// folder is, and the wizard stops there if it can't.
    /// </summary>
    private IReadOnlyList<GalleryEntry> OnThisPath(IReadOnlyList<GalleryEntry> entries) => Mode switch
    {
        WizardMode.ModelsOnly => entries
            .Where(e => e.Workload.ModelDownloads.Any(m => m.Enabled))
            .Select(e => e with { IsInstallable = true, Incompatibility = null })
            .ToList(),
        WizardMode.UpdateExisting => entries
            .Where(e => e.Workload.ModelDownloads.Any(m => m.Enabled) || e.Workload.Workflows.Count > 0 || BringsNodes(e.Workload))
            .Select(e => e with { IsInstallable = true, Incompatibility = null })
            .ToList(),
        _ => entries,
    };

    /// <summary>A node beyond the Manager: only the Manager is what Update only already does.</summary>
    private static bool BringsNodes(InstallationConfiguration workload) =>
        workload.GitRepositories.Any(r => !ExtendConfigurationMerger.HasManagerRepository(new InstallationConfiguration { GitRepositories = [r] }));

    private int VersionOf(InstallationConfiguration workload) =>
        _versions.TryGetValue(workload.Id, out var version)
            ? version
            : WorkloadVersions.ForMemory(WorkloadVersions.Tiers(workload), _memoryGb);

    private void OnSelectMultipleChanged(ChangeEventArgs e)
    {
        _selectMultiple = e.Value is true;
        if (!_selectMultiple) return;

        _memoryGb = StartingMemoryGb;
        _versions.Clear();
        _included.Clear();
    }

    /// <summary>Resets every card, including ones changed by hand (the owner's decision).</summary>
    private void OnMemoryChanged(int memoryGb)
    {
        _memoryGb = memoryGb;
        _versions.Clear();
    }

    private void OnIncluded(Guid id, bool on)
    {
        if (on) _included.Add(id);
        else _included.Remove(id);
    }

    private void UpdateOnly() => Nav.NavigateTo(WizardRoutes.UpdateOnly);

    private void Continue()
    {
        Picks.Set(Mode, _entry!.Workloads
            .Where(e => _included.Contains(e.Workload.Id))
            .Select(e => new WorkloadPick(e.Workload.Id, VersionOf(e.Workload)))
            .ToList());
        Nav.NavigateTo(WizardRoutes.Selected(Mode));
    }

    private IEnumerable<GalleryEntry> Filtered() => Visible()
        .Where(e => _type is null || e.Workload.WorkflowType == _type);

    /// <summary>
    /// Derived from the workloads on screen, so the button set answers "what can ComfyUI make",
    /// not "what types exist somewhere in the catalog" -- nor what a hidden legacy pack makes. A
    /// filter that can only ever return nothing is a dead control.
    /// </summary>
    private IEnumerable<WorkflowType> AvailableTypes() => Visible()
        .Select(e => e.Workload.WorkflowType)
        .Distinct()
        .OrderBy(t => t.ToString(), StringComparer.CurrentCultureIgnoreCase);

    private void OnShowLegacyChanged(ChangeEventArgs e)
    {
        _showLegacy = (bool)(e.Value ?? false);

        // Switching off can take away the chosen type's button along with its only packs. Left
        // set, the grid would go empty with nothing lit to say why.
        if (_type is { } type && !AvailableTypes().Contains(type))
        {
            _type = null;
        }
    }

    private string TypeClass(WorkflowType? type) => _type == type ? "filter-active" : "filter";

    private void Install(GalleryEntry entry) => Nav.NavigateTo(WizardRoutes.Install(entry.Workload.Id, Mode));
}
