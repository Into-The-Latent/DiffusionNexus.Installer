<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      The Installer SDK is published to GitHub Packages under the Little-God1983 account.
      This repo lives under Into-The-Latent, so restoring the SDK is a CROSS-ACCOUNT read:
      GITHUB_PACKAGES_TOKEN must be a token with read:packages that can see Little-God1983's
      packages. CI will fail its first SDK restore without it.
    -->
    <add key="github-littlegod" value="https://nuget.pkg.github.com/Little-God1983/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github-littlegod>
      <add key="Username" value="Little-God1983" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </github-littlegod>
  </packageSourceCredentials>
</configuration>
